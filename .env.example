# =============================================================================
# SSAMS — root environment for the one-command launcher (npm start)
# Copy to `.env` and adjust. NEVER commit a real `.env` (it is git-ignored).
# Every value here has a safe default in scripts/start.js; only override what you
# need. Values set here override the launcher defaults but the real process
# environment (exported vars / your shell / a PaaS) overrides this file.
# =============================================================================

# --- Public port the app is served on (backend serves the SPA + API here) -----
PORT=4000

# --- Database (REQUIRED for production) ---------------------------------------
# Use a managed Postgres (Neon / Supabase / RDS / your own). The launcher runs
# `prisma migrate deploy` against this URL on every start.
# If you leave this empty the launcher will try `npm run db:local` (needs local
# PostgreSQL or Docker) to spin one up for you.
DATABASE_URL=

# --- Auth secrets (generate strong random values for real deployments) --------
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies -----------------------------------------------------------------
# In production (a public https origin) leave this true so httpOnly session
# cookies are only sent over HTTPS. The launcher sets it automatically from the
# tunnel URL when one is used.
COOKIE_SECURE=true

# --- AI service (internal, called only by the backend) ------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
AI_SERVICE_TIMEOUT_MS=8000

# --- Database seeding ---------------------------------------------------------
# Set to "true" to load demo Admin/Teacher/Student accounts on first run.
SSAMS_SEED=false

# --- Local database convenience ----------------------------------------------
# Set to "1" to have the launcher start a local PostgreSQL (scripts/db-local.sh)
# when DATABASE_URL is empty. Needs PostgreSQL or Docker installed.
SSAMS_LOCAL_DB=0

# --- Public tunnel ------------------------------------------------------------
# auto | cloudflared | ngrok. cloudflared needs no account for quick tunnels.
# Pass --no-tunnel to the launcher to disable.
TUNNEL_PROVIDER=auto
