# ---------------------------------------------------------------------------
# SSAMS Backend Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Windows example (local PostgreSQL install, default port 5432):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ssams?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ssams?schema=public"

# Server
PORT=4000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# URLs
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=8000

# JWT / Auth secrets - generate strong random values for real deployments.
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-this-access-secret-in-env-minimum-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-in-env-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Attendance defaults (overridable per-department via /admin/settings)
ATTENDANCE_DEFAULT_RADIUS=100
MIN_ATTENDANCE_PERCENTAGE=75
FACE_MATCH_THRESHOLD=0.62
VERIFICATION_SESSION_TTL_MINUTES=5
MAX_VERIFICATION_ATTEMPTS=3

# Rate limiting
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
ATTENDANCE_RATE_LIMIT_MAX=20
ATTENDANCE_RATE_LIMIT_WINDOW_MINUTES=10

# Logging
LOG_LEVEL=info
