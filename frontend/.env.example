# ---------------------------------------------------------------------------
# SSAMS Frontend Environment Configuration
# Copy this file to `.env.development` (or `.env`) and adjust as needed.
# NEVER commit real `.env` files - they are git-ignored.
#
# IMPORTANT: every VITE_* variable is bundled into the browser output and is
# therefore PUBLIC. Only put non-secret configuration here. Never add database
# credentials, JWT signing secrets or any other backend secret to this file.
# ---------------------------------------------------------------------------

# Base URL of the backend REST API.
#
# Default `/api` is a same-origin relative path: the Vite dev server proxies it
# to the Node backend (see VITE_DEV_PROXY_TARGET below). Using a relative path
# keeps the httpOnly authentication cookies first-party, which is required for
# the cookie-based session/refresh flow to work in the browser.
VITE_API_URL=/api

# Dev/preview server only: where the `/api` proxy forwards requests.
# Windows example: http://localhost:4000
VITE_DEV_PROXY_TARGET=http://localhost:4000

# Port used by `npm run dev` and `npm run preview`.
PORT=5173

# Application display name shown on the login page and in the sidebar.
VITE_APP_NAME=Smart Attendance

# When the backend is deployed on a different origin in production, set the
# absolute API URL there instead, e.g.:
#   VITE_API_URL=https://api.your-college-domain.example/api
# and make sure the backend CORS_ORIGIN allows the frontend origin.
